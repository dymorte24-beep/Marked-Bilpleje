# Nye butikker oprettet via admin-panelet får ikke deres egen statiske fil —
# denne regel viser i stedet den fælles skabelon (bilpleje/profil.html) på samme pæne URL.
# Rigtige filer har forrang og rammes IKKE af denne regel.
/bilpleje/:city/:slug/  /bilpleje/profil.html  200

# Samme idé for byside: /bilpleje/{by}/ viser den fælles bysides-skabelon,
# der henter alle butikker i den by fra databasen. Virker automatisk for enhver by.
/bilpleje/:city/  /bilpleje/by.html  200
